// multiplication sum

import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		
		int pack = sc.nextInt();
		int time = sc.nextInt();
		
		int total = pack*time;
		System.out.println(total);
		
		

	}
}
